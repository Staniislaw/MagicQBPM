{
    "_comentariu": [
        "SHOW NOU - Execute Page 1 (E38), grila 10 coloane x 8 randuri.",
        "Rulare:  py -3.12 main.py     (setul asta e cel implicit)",
        "",
        "!!! RECALIBREAZA: grila era 11x7, acum e 10x8 !!!",
        "   py -3.12 main.py --calibrate exec",
        "   py -3.12 main.py --test-exec",
        "",
        "=========== APARATELE ===========",
        "   INT  = IntSpot355ZIRC  (G1)   grup 'grup_int'",
        "   BEAM = FOSBeam150Pro   (G3)   grup 'grup_beam'",
        "   PAR  = LEDPar64        (G2)   grup 'grup_par'",
        "",
        "=========== MEREU APRINSE ===========",
        "CS2 on int, CS3 on fos beam, CS9 on par se aprind la primul sunet si",
        "raman asa. Se verifica pe ecran ('ensure: on'), deci nu se sting din",
        "greseala daca erau deja pornite.",
        "",
        "=========== MISCARILE ===========",
        "   INT  : CS14 DINAMIC INT",
        "   BEAM : CS5 dinamix beam (rapid)  /  CS23 beam lent (calm)",
        "Cele doua de beam sunt exclusive intre ele: la energie mare 'dinamix',",
        "cand muzica scade 'beam lent'.",
        "",
        "=========== EFECTELE (3 grupuri exclusive) ===========",
        "   fx_int  : CS6 fx1 int | CS7 fx2 stins-aprins | CS24 fx3 int",
        "   fx_beam : CS8 fx1 beam | CS16 fx incet beam",
        "   fx_par  : CS10 fx1 par | CS11 fx2 par | CS15 FX2 PAR | CS20 2x2 par",
        "CS21 '2x2 ca' e combinat cu inturile, deci intra in grupul fx_int.",
        "",
        "=========== VITEZA (nou - abia acum se poate) ===========",
        "Pana acum viteza efectelor nu putea fi controlata deloc. Show-ul asta",
        "are butoane dedicate:",
        "   Inc SP2 / Dec SP2  viteza FX-urilor de capuri si beamuri",
        "   Inc SP3 / Dec SP3  viteza FX-urilor de paruri",
        "   Tap SP2 / Tap SP3  sincronizare cu BPM-ul detectat",
        "Regulile apasa Inc/Dec de mai multe ori, cu \"repeat\", ca sa urce sau",
        "sa coboare viteza in trepte: build-up accelereaza, break incetineste.",
        "",
        "=========== STROBE / BLACK ===========",
        "   CS17 stribe   strobe general",
        "   B23 shut med  strobe doar pe capul selectat (mai subtil)",
        "   CS18 black    inchide tot - folosit scurt, ca taietura la drop",
        "Toate au \"duration\", deci se sting singure.",
        "",
        "=========== CULORILE ===========",
        "CS13 '4 COL' face fade automat de culori. E aprins in groove, si se",
        "STINGE cand vrem culori proprii (la drop), altfel s-ar bate cu ele.",
        "Culorile manuale se dau prin panoul BPM & Culori."
    ],

    "rules": [
        {
            "name": "1. Muzica porneste -> aprinde tot ce sta aprins",
            "on": "SIGNAL",
            "cooldown": 5.0,
            "priority": 1,
            "do": [
                { "action": "palette", "window": "exec", "name": "on_int",      "ensure": "on" },
                { "action": "palette", "window": "exec", "name": "on_fos_beam", "ensure": "on" },
                { "action": "palette", "window": "exec", "name": "on_par",      "ensure": "on" },
                { "action": "palette", "window": "exec", "name": "shut_open",   "ensure": "on" },
                { "action": "palette", "window": "exec", "name": "dinamic_int", "ensure": "on" }
            ]
        },

        {
            "name": "2. INTRO -> calm",
            "on": "INTRO",
            "cooldown": 10.0,
            "do": [
                { "action": "palette", "window": "exec", "name": "beam_lent",
                  "exclusive": "misc_beam", "exclusive_hold": 25,
                  "members": ["dinamic_beam", "beam_lent"] },
                { "action": "palette", "window": "exec", "name": "fx1_int",
                  "exclusive": "fx_int", "exclusive_hold": 20,
                  "members": ["fx1_int", "fx2_int", "fx3_int", "fx_2x2_ca"] }
            ]
        },
        {
            "name": "3. GROOVE -> fx normale + fade automat de culori",
            "on": "GROOVE",
            "cooldown": 10.0,
            "do": [
                { "action": "palette", "window": "exec", "name": "dinamic_beam",
                  "exclusive": "misc_beam", "exclusive_hold": 25,
                  "members": ["dinamic_beam", "beam_lent"] },
                { "action": "palette", "window": "exec", "name": "fx1_int",
                  "exclusive": "fx_int", "exclusive_hold": 20,
                  "members": ["fx1_int", "fx2_int", "fx3_int", "fx_2x2_ca"] },
                { "action": "palette", "window": "exec", "name": "fx1_beam",
                  "exclusive": "fx_beam", "exclusive_hold": 20,
                  "members": ["fx1_beam", "fx_incet_beam"] },
                { "action": "palette", "window": "exec", "name": "fx1_par",
                  "exclusive": "fx_par", "exclusive_hold": 20,
                  "members": ["fx1_par", "fx2_par", "fx2_par_b", "fx_2x2_par"] },
                { "action": "palette", "window": "exec", "name": "auto_4col",
                  "ensure": "on" }
            ]
        },
        {
            "name": "4. BUILDUP -> fx mai agresive + ACCELEREAZA",
            "on": "BUILDUP",
            "cooldown": 12.0,
            "description": "Inc SP2 de 3 ori si Inc SP3 de 2 ori: efectele se accelereaza odata cu muzica.",
            "do": [
                { "action": "palette", "window": "exec", "name": "fx2_int",
                  "exclusive": "fx_int", "exclusive_hold": 15,
                  "members": ["fx1_int", "fx2_int", "fx3_int", "fx_2x2_ca"] },
                { "action": "palette", "window": "exec", "name": "dinamic_beam",
                  "exclusive": "misc_beam", "exclusive_hold": 15,
                  "members": ["dinamic_beam", "beam_lent"] },
                { "action": "palette", "window": "exec", "name": "inc_sp2",
                  "repeat": 3, "interval": 0.12 },
                { "action": "palette", "window": "exec", "name": "inc_sp3",
                  "repeat": 2, "interval": 0.12 }
            ]
        },
        {
            "name": "5. DROP -> tot pe maxim",
            "on": "DROP",
            "if": "drop_score > 0.70",
            "cooldown": 10.0,
            "priority": 1,
            "do": [
                { "action": "palette", "window": "exec", "name": "fx_2x2_ca",
                  "exclusive": "fx_int", "exclusive_hold": 8,
                  "members": ["fx1_int", "fx2_int", "fx3_int", "fx_2x2_ca"] },
                { "action": "palette", "window": "exec", "name": "fx1_beam",
                  "exclusive": "fx_beam", "exclusive_hold": 8,
                  "members": ["fx1_beam", "fx_incet_beam"] },
                { "action": "palette", "window": "exec", "name": "fx_2x2_par",
                  "exclusive": "fx_par", "exclusive_hold": 8,
                  "members": ["fx1_par", "fx2_par", "fx2_par_b", "fx_2x2_par"] }
            ]
        },
        {
            "name": "6. DROP PUTERNIC -> black scurt + strobe",
            "on": "DROP",
            "if": "drop_score > 0.75",
            "cooldown": 20.0,
            "priority": 0,
            "description": "CS18 black taie 0.3 s, apoi CS17 stribe 1.6 s. Ambele se sting singure.",
            "do": [
                { "action": "palette", "window": "exec", "name": "black",  "duration": 0.30 },
                { "action": "palette", "window": "exec", "name": "strobe", "duration": 1.60 },
                { "action": "palette", "window": "exec", "name": "auto_4col", "ensure": "off" }
            ]
        },
        {
            "name": "7. CLIMAX -> shut med pe capuri",
            "on": "CLIMAX",
            "cooldown": 25.0,
            "description": "B23 shut med: strobe doar pe capuri, mai subtil decat strobe-ul general.",
            "do": [
                { "action": "palette", "window": "exec", "name": "shut_med", "duration": 2.5 }
            ]
        },
        {
            "name": "8. BREAK -> calm + INCETINESTE",
            "on": "BREAK",
            "cooldown": 10.0,
            "do": [
                { "action": "palette", "window": "exec", "name": "beam_lent",
                  "exclusive": "misc_beam", "exclusive_hold": 20,
                  "members": ["dinamic_beam", "beam_lent"] },
                { "action": "palette", "window": "exec", "name": "fx_incet_beam",
                  "exclusive": "fx_beam", "exclusive_hold": 15,
                  "members": ["fx1_beam", "fx_incet_beam"] },
                { "action": "palette", "window": "exec", "name": "dec_sp2",
                  "repeat": 3, "interval": 0.12 },
                { "action": "palette", "window": "exec", "name": "dec_sp3",
                  "repeat": 2, "interval": 0.12 },
                { "action": "palette", "window": "exec", "name": "shut_open", "ensure": "on" },
                { "action": "palette", "window": "exec", "name": "auto_4col", "ensure": "on" }
            ]
        },
        {
            "name": "9. OUTRO -> revenire linistita",
            "on": "OUTRO",
            "cooldown": 20.0,
            "do": [
                { "action": "palette", "window": "exec", "name": "beam_lent",
                  "exclusive": "misc_beam", "exclusive_hold": 20,
                  "members": ["dinamic_beam", "beam_lent"] },
                { "action": "palette", "window": "exec", "name": "fx1_int",
                  "exclusive": "fx_int", "exclusive_hold": 15,
                  "members": ["fx1_int", "fx2_int", "fx3_int", "fx_2x2_ca"] },
                { "action": "palette", "window": "exec", "name": "dec_sp2",
                  "repeat": 4, "interval": 0.12 }
            ]
        },

        {
            "name": "10. TAP SP2 - rafala la tempo nou",
            "on": "BEAT",
            "if": "bpm_age < 3.5 and bpm_conf > 0.45 and not is_silence",
            "cooldown": 0.15,
            "priority": 0,
            "description": "Sincronizeaza viteza FX-urilor de capuri cu muzica.",
            "do": [
                { "action": "palette", "window": "exec", "name": "tap_sp2" }
            ]
        },
        {
            "name": "11. TAP SP3 - viteza parurilor, la fiecare 32 de masuri",
            "on": "DOWNBEAT",
            "if": "bar % 32 == 0 and bpm_conf > 0.5 and not is_silence",
            "cooldown": 45.0,
            "priority": 0,
            "do": [
                { "action": "palette", "window": "exec", "name": "tap_sp3",
                  "repeat": 6, "interval": "beat" }
            ]
        },

        {
            "name": "12. Energie mare sustinuta -> strobe scurt",
            "when": "energy > 82 and bass_avg > 62 and not is_break",
            "mode": "edge",
            "hold": 4.0,
            "cooldown": 20.0,
            "description": "Al doilea declansator de strobe, independent de detectorul de drop.",
            "do": [
                { "action": "palette", "window": "exec", "name": "strobe", "duration": 1.0 }
            ]
        },
        {
            "name": "13. Muzica scade -> beam lent",
            "when": "energy_mid < 45 or (energy_slope < -0.02 and energy_mid < 62)",
            "mode": "edge",
            "hold": 6.0,
            "cooldown": 20.0,
            "do": [
                { "action": "palette", "window": "exec", "name": "beam_lent",
                  "exclusive": "misc_beam", "exclusive_hold": 15,
                  "members": ["dinamic_beam", "beam_lent"] }
            ],
            "undo": [
                { "action": "palette", "window": "exec", "name": "dinamic_beam",
                  "exclusive": "misc_beam", "exclusive_hold": 15,
                  "members": ["dinamic_beam", "beam_lent"] }
            ]
        },

        {
            "name": "14. Liniste -> opreste efectele, lasa lumina",
            "on": "SILENCE",
            "cooldown": 15.0,
            "priority": 0,
            "description": "Nu stinge on_int / on_par: la liniste vrei sa ramana lumina in sala.",
            "do": [
                { "action": "exclusive_off", "group": "fx_par" },
                { "action": "palette", "window": "exec", "name": "beam_lent",
                  "exclusive": "misc_beam",
                  "members": ["dinamic_beam", "beam_lent"] },
                { "action": "palette", "window": "exec", "name": "shut_open", "ensure": "on" },
                { "action": "palette", "window": "exec", "name": "auto_4col", "ensure": "on" }
            ]
        },

        {
            "name": "20. Kick in drop -> shut med scurt (optional)",
            "on": "BEAT",
            "if": "bass > 78 and is_drop",
            "cooldown": 0.8,
            "enabled": false,
            "do": [
                { "action": "palette", "window": "exec", "name": "shut_med", "duration": 0.20 }
            ]
        }
    ]
}
